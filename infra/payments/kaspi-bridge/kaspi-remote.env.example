# Server only. Never EXPO_PUBLIC_*. Never commit the filled copy.
# Kaspi remote invoice через локальный мост (неофициальная сессия кассира Kaspi Pay).
KASPI_REMOTE_ENABLED=false
# Only loopback: the bridge must never listen on a public interface.
KASPI_BRIDGE_URL=http://127.0.0.1:3931
# openssl rand -hex 32 ; the same value goes into the bridge webhooks.json (only if BRIDGE_POLLING=on).
KASPI_BRIDGE_WEBHOOK_SECRET=
# UUID of the commerce_provider_accounts row with provider='kaspi-remote', kind='payment'.
KASPI_REMOTE_ACCOUNT_ID=
# How long an unpaid fast-food invoice lives before PickChick cancels it (120..86400).
KASPI_INVOICE_TTL_SECONDS=600
# Written by kaspi-login.mjs into a separate 0600 file; do not copy by hand into chats.
# KASPI_SESSION_TOKEN_SN=
# KASPI_SESSION_VTOKEN_SECRET=
# KASPI_SESSION_PROFILE_ID=
