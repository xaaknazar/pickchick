# Server only. Never EXPO_PUBLIC_*. Never commit the filled copy.
TIPTOPPAY_PUBLIC_ID=
TIPTOPPAY_API_SECRET=
# Independent of the provider cabinet setting; this does not switch its terminal.
TIPTOPPAY_MODE=test
TIPTOPPAY_WEBHOOKS_ENABLED=false
# UUID of a verified commerce_provider_accounts row, not the Public ID.
TIPTOPPAY_ACCOUNT_ID=
# Webkassa integration is awaiting the current provider API/Postman contract.
FISCAL_PROVIDER=webkassa
WEBKASSA_ENABLED=false

# Hosted checkout rollout, OFF until the live terminal + merchant + domain are verified.
TIPTOPPAY_CHECKOUT_ENABLED=false
TIPTOPPAY_LIVE_VERIFIED=false
TIPTOPPAY_CHECKOUT_ORIGIN=https://pickchick.185.129.51.103.nip.io
TIPTOPPAY_CHECKOUT_METHODS=card
# TipTop manager must enable restrictedPaymentMethods/paymentMethodSequence.
TIPTOPPAY_METHOD_ROUTING_VERIFIED=false
TIPTOPPAY_APPLE_PAY_DOMAIN_VERIFIED=false
# Explicit, recorded merchant-specific pilot approval. Not a fiscal receipt.
TIPTOPPAY_FISCAL_DEFERRAL_REFERENCE=
# Separate read-only-bank reconciliation worker; does not charge/refund cards.
TIPTOPPAY_RECONCILE_ENABLED=false

# Isolated sandbox sessions; these never create commercial orders or captures.
# Can coexist with LIVE Kaspi. Requires migration 040 and explicit TEST grants.
TIPTOPPAY_TEST_CHECKOUT_ENABLED=false
TIPTOPPAY_TEST_WEBHOOKS_ENABLED=false
# Integer minor units; otherwise uses the existing Kaspi pilot maximum.
TIPTOPPAY_TEST_MAX_MINOR=
