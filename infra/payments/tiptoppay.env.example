# Server only. Never EXPO_PUBLIC_*. Never commit the filled copy.
TIPTOPPAY_PUBLIC_ID=
TIPTOPPAY_API_SECRET=
# Independent of the provider cabinet setting; this does not switch its terminal.
TIPTOPPAY_MODE=test
TIPTOPPAY_WEBHOOKS_ENABLED=false
# UUID of a verified commerce_provider_accounts row, not the Public ID.
TIPTOPPAY_ACCOUNT_ID=
# Webkassa integration is awaiting the current provider API/Postman contract.
FISCAL_PROVIDER=webkassa
WEBKASSA_ENABLED=false
