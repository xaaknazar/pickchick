# PickChick off-site backups (backup-offsite.py). Copy to /opt/pickchick-staging/secrets/backup-offsite.env,
# owner pickchick-ops, mode 0600 (anything else is refused). Never commit the filled copy.
# Everything uploaded is already age-encrypted with secrets/backup-recipient.txt.

# --- Off-site copy of the daily dump (off = local copies only, as before) ---
BACKUP_OFFSITE_ENABLED=false
# S3-compatible endpoint of the independent storage (another provider/region in KZ), https only.
BACKUP_S3_ENDPOINT=https://s3.example.invalid
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pickchick-staging
# path: https://endpoint/bucket/key ; virtual: https://bucket.endpoint/key (provider-specific).
BACKUP_S3_ADDRESSING=path
# Write-only key for this VPS (PutObject on the prefix only; no delete, no list, no read).
# Retention and immutability are bucket settings: versioning/object lock + lifecycle rule.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- PITR option (owner decision; needs the off-site copy, ALTER SYSTEM and one cloud-db restart) ---
BACKUP_PITR_ENABLED=false
BACKUP_DB_CONTAINER=pickchick-staging-cloud-db-1
BACKUP_WAL_ARCHIVE_DIR=/var/lib/postgresql/wal-archive
