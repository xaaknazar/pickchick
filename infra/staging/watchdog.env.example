# PickChick watchdog. Copy to /opt/pickchick-staging/secrets/watchdog.env, owner pickchick-ops,
# mode 0600 (run-watchdog.py refuses anything else). Never commit the filled copy.

# --- Telegram (off = shadow mode: alerts are only printed to the journal) ---
WATCHDOG_TELEGRAM_ENABLED=false
# From @BotFather, e.g. 1234567890:AA... ; never paste it into chats or tickets.
WATCHDOG_TELEGRAM_BOT_TOKEN=
# Numeric chat id of the private operations chat (groups are negative).
WATCHDOG_TELEGRAM_CHAT_ID=

# --- Read-only database role (infra/staging/watchdog-grants.mjs) ---
# openssl rand -hex 32 ; written straight into this file, never echoed.
WATCHDOG_DB_PASSWORD=
WATCHDOG_DB_USER=pickchick_watchdog
WATCHDOG_DB_NAME=pickchick_cloud
WATCHDOG_DB_HOST=cloud-db
WATCHDOG_DB_PORT=5432

# --- What to watch ---
WATCHDOG_LABEL=PickChick staging
WATCHDOG_TIMEZONE=Asia/Almaty
WATCHDOG_API_READY_URL=http://api:3100/health/ready
WATCHDOG_EXPECT_KASPI_BRIDGE=true
WATCHDOG_EXPECT_KASPI_REMOTE_WORKER=true
WATCHDOG_EXPECT_KIOSK_QR_WORKER=true

# --- Thresholds ---
WATCHDOG_API_CONFIRM_RUNS=2
WATCHDOG_CONTAINER_CONFIRM_RUNS=2
WATCHDOG_WORKER_ERROR_CONFIRM_RUNS=2
WATCHDOG_HEARTBEAT_STALE_MINUTES=10
# Optional local window when the cashier PC may be off, e.g. 23:30-08:30. Empty = always check.
WATCHDOG_HEARTBEAT_QUIET_HOURS=
WATCHDOG_IDENTITY_WARN_DAYS=7
WATCHDOG_BACKUP_MAX_AGE_HOURS=26
WATCHDOG_DISK_WARN_PERCENT=85
WATCHDOG_DISK_CRITICAL_PERCENT=95
# Kaspi payments not sent to the bank / paid orders not taken by the cashier kitchen (critical).
WATCHDOG_PAYMENT_BACKLOG_MINUTES=5
WATCHDOG_KITCHEN_BACKLOG_MINUTES=5
# New manager review cases (reconciliation issues, e.g. a refused or overdue kitchen admission
# of a paid order) stay critical for this many hours; they have no resolved state.
WATCHDOG_REVIEW_WINDOW_HOURS=6
WATCHDOG_FACTS_MAX_AGE_MINUTES=15
# Off-site copy and PITR (infra/staging/backup-offsite.env.example). Turn on once configured:
# then a missing or stale copy is critical. Their status files are checked whenever present.
WATCHDOG_EXPECT_BACKUP_OFFSITE=false
WATCHDOG_BACKUP_OFFSITE_MAX_AGE_HOURS=26
WATCHDOG_EXPECT_BACKUP_PITR=false
WATCHDOG_WAL_MAX_DELAY_MINUTES=15

# --- De-duplication and summary ---
WATCHDOG_RENOTIFY_MINUTES=120
WATCHDOG_DAILY_SUMMARY=false
WATCHDOG_DAILY_SUMMARY_HOUR=9

# --- Host collector (run-watchdog.py) ---
WATCHDOG_LOG_WINDOW_SECONDS=600
WATCHDOG_DISK_PATHS=/,/var/lib/docker,/opt/pickchick-staging/backups
WATCHDOG_BACKUP_DIR=/opt/pickchick-staging/backups
WATCHDOG_STAGING_NETWORK=pickchick-staging_private
# 0 = never call the bank. 6..168 = run the bridge's read-only session-check.mjs at most
# once per that many hours (one extra bank request each time). Owner decision required.
WATCHDOG_KASPI_SESSION_PROBE_HOURS=0
# Container whose logs carry fulfillment_transport_attention. Empty: the fulfillment worker runs
# as the Windows cashier service; the kitchen backlog database check covers it.
WATCHDOG_FULFILLMENT_CONTAINER=
