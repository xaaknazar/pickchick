	# Kiosk availability may wait 25 seconds for an unchanged snapshot.
	@kiosk_availability_watch {
		method GET
		path /v1/kiosk-checkout/availability
	}
	handle @kiosk_availability_watch {
		reverse_proxy pickchick-public-gateway:8080 {
			transport http {
				dial_timeout 2s
				response_header_timeout 32s
			}
		}
	}
