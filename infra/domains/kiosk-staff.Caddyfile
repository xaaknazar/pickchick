	# BEGIN KIOSK STAFF CODE
	@kiosk_staff_verify {
		method POST
		path /v1/kiosk-checkout/staff/verify
	}
	handle @kiosk_staff_verify {
		header X-PickChick-Data kiosk
		request_body {
			max_size 1KB
		}
		reverse_proxy pickchick-staging-api-1:3100 {
			header_up -Cookie
			header_up -Authorization
			header_up -X-Device-Id
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}
	# END KIOSK STAFF CODE
