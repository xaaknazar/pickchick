	# BEGIN DEVICE CENTER PRESENCE
	@device_center_presence {
		method POST
		path /v1/kiosk-checkout/device-presence
	}
	handle @device_center_presence {
		header X-PickChick-Data device-status
		request_body {
			max_size 4KB
		}
		reverse_proxy pickchick-staging-api-1:3100 {
			header_up -Cookie
			header_up -Authorization
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}
	# END DEVICE CENTER PRESENCE
