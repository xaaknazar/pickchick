{
	admin off
	auto_https off
	persist_config off
	servers {
		max_header_size 32KB
		timeouts {
			read_header 5s
			read_body 5s
			write 10s
			idle 30s
		}
	}
}

:8080 {
	header {
		Content-Type application/json
		Cache-Control no-store
		X-Content-Type-Options nosniff
		X-PickChick-Environment staging
		X-PickChick-Data synthetic
		X-PickChick-Ordering disabled
		-Server
	}
	request_body {
		max_size 16KB
	}

	@capabilities {
		method GET
		path /v1/capabilities
	}
	handle @capabilities {
		header Access-Control-Allow-Origin *
		respond `{"schema_version":1,"environment":"staging","data_mode":"synthetic","ordering_enabled":false,"features":{"phone_auth":false,"checkout":false,"payments":false,"fiscal":false,"loyalty":false},"notice":{"ru":"Тестовый стенд PickChick. Данные демонстрационные; оформление заказов, SMS, оплаты и чеки пока недоступны.","kk":"PickChick сынақ ортасы. Деректер демонстрациялық; тапсырыс беру, SMS, төлемдер мен чектер әзірге қолжетімсіз."}}` 200
	}

	@health {
		method GET
		path /health/live
	}
	handle @health {
		header Access-Control-Allow-Origin *
		respond `{"service":"pickchick-public-gateway","alive":true,"environment":"staging"}` 200
	}

	@catalog {
		method GET
		path /v1/branches /v1/branches/10000000-0000-4000-8000-000000000003/menu
	}
	handle @catalog {
		header Access-Control-Allow-Origin *
		reverse_proxy pickchick-staging-api-1:3100 {
			header_up -Authorization
			header_up -Cookie
			header_up -X-Device-Id
			transport http {
				dial_timeout 2s
				response_header_timeout 5s
			}
		}
	}

	handle {
		respond `{"code":"NOT_FOUND","environment":"staging"}` 404
	}
}
