# Synthetic local-only infrastructure. Never use these credentials outside localhost.
APP_ENV=local
POSTGRES_USER=pickchick_local
POSTGRES_PASSWORD=pickchick_local_only
CLOUD_DATABASE_URL=postgresql://pickchick_local:pickchick_local_only@127.0.0.1:55432/pickchick_cloud
EDGE_DATABASE_URL=postgresql://pickchick_local:pickchick_local_only@127.0.0.1:55433/pickchick_edge
REDIS_URL=redis://127.0.0.1:56379
API_PORT=3100
EDGE_PORT=3101
EDGE_BRANCH_ID=10000000-0000-4000-8000-000000000003

# Per-process budgets; sum DB pools across API/worker replicas before raising.
DB_POOL_MAX=5
HTTP_MAX_IN_FLIGHT=32
# Separate long-poll and cashier edge budgets (docs/operations/http-admission-pools.md).
# The per-IP long-poll cap is opt-in and requires TRUSTED_PROXY_IPS naming the gateway.
HTTP_MAX_LONG_POLL=64
HTTP_LONG_POLL_PER_IP_ENABLED=false
HTTP_MAX_LONG_POLL_PER_IP=16
HTTP_MAX_EDGE_IN_FLIGHT=16
HTTP_LONG_POLL_OVERFLOW_DELAY_MS=5000

# Real customer identity is opt-in; demo/test ordering remains a separate domain.
# Set approved policy URLs/version, private keys, sender and SMS budget before enabling.
CUSTOMER_AUTH_ENABLED=false
# Share of the daily code budget that new phone numbers may use (1-100, default 80);
# the rest is kept for returning customers.
# CUSTOMER_AUTH_NEW_PHONE_BUDGET_PERCENT=80
# Customer session lifetime and idle timeout in days (defaults 90 and 30).
# CUSTOMER_AUTH_SESSION_MAX_DAYS=90
# CUSTOMER_AUTH_SESSION_IDLE_DAYS=30
# App Review sign-in: one fixed KZ phone with a fixed 4-digit code, no message sent, never pays.
# Digest: printf 'pickchick-review-code-v1:%s' <code> | sha256sum. Default off.
# CUSTOMER_REVIEW_ACCOUNT_ENABLED=false
# CUSTOMER_REVIEW_ACCOUNT_PHONE=
# CUSTOMER_REVIEW_ACCOUNT_CODE_SHA256=
CATALOG_ADMIN_ENABLED=false
PHONE_DELIVERY_PROVIDER=disabled

# POS lifecycle replication only; these do not enable sales or kitchen admission.
CLOUD_POS_ORDER_SYNC_ENABLED=false
EDGE_POS_ORDER_SYNC_ENABLED=false

# Private branch-scoped backoffice, explicit manager grants required.
BACKOFFICE_ENABLED=false
# Managers may queue stop/unstop commands for the cashier edge (needs cloud048 + edge protocol 4).
BACKOFFICE_REMOTE_STOPS_ENABLED=false
# Managers record refunds made by hand in Kaspi Pay (no refund adapter exists). Needs
# manualRefundGrants on the API role, applied after the other grant helpers.
BACKOFFICE_MANUAL_REFUNDS_ENABLED=false

# Mobile Kaspi checkout (server only; the pilot stays off unless CUSTOMER_KASPI_PILOT_ENABLED=true).
# Owner switch without a release: false closes new mobile Kaspi payments ("payments unavailable").
# CUSTOMER_KASPI_SALES_ENABLED=true
# Mobile orders never sent to the bank are cancelled unpaid after this many minutes (0 = off).
# CUSTOMER_UNPAID_ORDER_TTL_MINUTES=30

# Release fixes 2026-10-19 (lane ful), bug fixes on by default; 0 turns a sweep off.
# A paid order still not admitted by the cashier this many minutes after payment goes to manager
# review instead of a late kitchen queue (cloud API, transport pull).
# FULFILLMENT_ADMISSION_REVIEW_MINUTES=15
# Cloud kitchen mode only: a ready order not handed over within this many minutes is closed by
# the system and its display number freed.
# CLOUD_KITCHEN_STALE_READY_MINUTES=180

# Edge device key renewal (cloud066, docs/operations/edge-identity-rotation.md). Both off by default.
# Cloud API accepts device-initiated renewal 10 days before expiry; the edge worker/Windows task renews.
CLOUD_EDGE_IDENTITY_ROTATION_ENABLED=false
EDGE_IDENTITY_AUTO_ROTATE=false

# Kiosk staff code (audit 19.10): demo mode, «Начать заново» after the first seconds of a QR and
# the service reset of a stuck kiosk need it. Empty = these staff actions are off. Generate the
# line on a trusted machine: node scripts/kiosk-staff-pin.mjs (the code is never stored).
KIOSK_STAFF_PIN_VERIFIER=
