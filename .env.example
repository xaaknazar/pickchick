# Synthetic local-only infrastructure. Never use these credentials outside localhost.
APP_ENV=local
POSTGRES_USER=pickchick_local
POSTGRES_PASSWORD=pickchick_local_only
CLOUD_DATABASE_URL=postgresql://pickchick_local:pickchick_local_only@127.0.0.1:55432/pickchick_cloud
EDGE_DATABASE_URL=postgresql://pickchick_local:pickchick_local_only@127.0.0.1:55433/pickchick_edge
REDIS_URL=redis://127.0.0.1:56379
API_PORT=3100
EDGE_PORT=3101
EDGE_BRANCH_ID=10000000-0000-4000-8000-000000000003

# Per-process budgets; sum DB pools across API/worker replicas before raising.
DB_POOL_MAX=5
HTTP_MAX_IN_FLIGHT=32

# Real customer identity is opt-in; demo/test ordering remains a separate domain.
# Set approved policy URLs/version, private keys, sender and SMS budget before enabling.
CUSTOMER_AUTH_ENABLED=false
# Share of the daily code budget that new phone numbers may use (1-100, default 80);
# the rest is kept for returning customers.
# CUSTOMER_AUTH_NEW_PHONE_BUDGET_PERCENT=80
# Customer session lifetime and idle timeout in days (defaults 90 and 30).
# CUSTOMER_AUTH_SESSION_MAX_DAYS=90
# CUSTOMER_AUTH_SESSION_IDLE_DAYS=30
# App Review sign-in: one fixed KZ phone with a fixed 4-digit code, no message sent, never pays.
# Digest: printf 'pickchick-review-code-v1:%s' <code> | sha256sum. Default off.
# CUSTOMER_REVIEW_ACCOUNT_ENABLED=false
# CUSTOMER_REVIEW_ACCOUNT_PHONE=
# CUSTOMER_REVIEW_ACCOUNT_CODE_SHA256=
CATALOG_ADMIN_ENABLED=false
PHONE_DELIVERY_PROVIDER=disabled

# POS lifecycle replication only; these do not enable sales or kitchen admission.
CLOUD_POS_ORDER_SYNC_ENABLED=false
EDGE_POS_ORDER_SYNC_ENABLED=false

# Private branch-scoped backoffice, explicit manager grants required.
BACKOFFICE_ENABLED=false
# Managers may queue stop/unstop commands for the cashier edge (needs cloud048 + edge protocol 4).
BACKOFFICE_REMOTE_STOPS_ENABLED=false
