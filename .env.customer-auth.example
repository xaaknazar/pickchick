# Owner approved 26 September 2026: at most 1000 reservations per UTC day,
# shared by Telegram and SMS. This cap is not an automatic Gateway top-up.
# Copy to a protected mode-600 file under .local; never commit filled values.
# Deliberately disabled until the release checklist in docs/operations/telegram-pilot.md passes.
CUSTOMER_AUTH_ENABLED=false
CUSTOMER_AUTH_DAILY_SMS_BUDGET=1000
# Fill with the version and HTTPS URLs of the actually published documents.
CUSTOMER_AUTH_CONSENT_VERSION=
CUSTOMER_AUTH_TERMS_URL=
CUSTOMER_AUTH_PRIVACY_URL=
# Four distinct cryptographic keys; preserve them across redeployments.
CUSTOMER_AUTH_LOOKUP_KEY=
CUSTOMER_AUTH_OTP_KEY=
CUSTOMER_AUTH_PII_KEY=
CUSTOMER_AUTH_RECEIPT_KEY=
# Provider settings are separate: .env.phone.example. No token belongs in mobile.
