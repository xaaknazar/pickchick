diff --git a/lib/check-depth.js b/lib/check-depth.js
new file mode 100644
index 0000000..920cd23
--- /dev/null
+++ b/lib/check-depth.js
@@ -0,0 +1,15 @@
+'use strict';
+
+// Bound recursive walkers before they consume caller-supplied ASTs.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 128 || seen.has(node)) throw new SyntaxError('Brace nesting exceeds safety limit');
+    seen.add(node);
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
