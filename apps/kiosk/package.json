  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web --port 4184",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform ios --platform web",
