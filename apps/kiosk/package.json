    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build -o ../../.local/ipad-design/storybook",
    "ui:check": "node --test ../../tests/kiosk/ui-architecture.test.mjs"
  },
