{
  "name": "@pickchick/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "PICKCHICK_APP_VARIANT=development EXPO_PUBLIC_UNPAID_TEST_ORDERS=1 EXPO_PUBLIC_PUBLISHED_CATALOG=0 expo start --dev-client --lan --scheme pickchick-dev",
    "dev:check": "node ../../scripts/mobile/check-dev-bundle.mjs",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "export": "expo export --platform all --clear",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "storybook": "storybook dev -p 6016",
    "storybook:build": "storybook build -o ../../.local/mobile-storybook"
  },
  "dependencies": {
    "@expo-google-fonts/jost": "0.4.2",
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@pickchick/catalog-admin": "workspace:*",
    "@pickchick/contracts": "workspace:*",
    "@pickchick/design-tokens": "workspace:*",
    "@pickchick/farm-game": "workspace:*",
    "@pickchick/test-order-flow": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "57.0.20",
    "expo-asset": "57.0.16",
    "expo-constants": "57.0.17",
    "expo-crypto": "57.0.2",
    "expo-dev-client": "57.0.18",
    "expo-font": "57.0.3",
    "expo-image": "57.0.4",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.19",
    "expo-secure-store": "57.0.3",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-video": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-native-web-vite": "10.6.1",
    "@types/react": "19.2.4",
    "storybook": "10.6.1",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
