{
  "expo": {
    "name": "PickChick",
    "slug": "pickchick",
    "version": "0.2.0",
    "icon": "../../design/prototype/assets/mockup/logo.png",
    "orientation": "portrait",
    "scheme": "pickchick",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.pickchick.app",
      "buildNumber": "7",
      "appleTeamId": "DAJTP6MC3Q",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["ru", "kk"]
      }
    },
    "android": {
      "package": "kz.pickchick.app",
      "versionCode": 7
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0133CC",
          "image": "../../design/prototype/assets/mockup/logo.png",
          "imageWidth": 320
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "environment": "staging",
      "apiUrl": "https://pickchick.185.129.51.103.nip.io",
      "customerOperationsEnabled": false
    }
  }
}
