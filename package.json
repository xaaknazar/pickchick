{
  "name": "pickchick-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:mobile": "node --test tests/mobile/*.test.mjs && python3 -m unittest discover -s tests/mobile -p 'test_*.py'",
    "test:kiosk": "node --test tests/kiosk/*.test.mjs",
    "test:integration": "node --env-file=.env --test --test-concurrency=1 tests/integration/*.test.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm contracts:check && pnpm design:check",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "infra:up": "docker compose --env-file .env -f infra/local/compose.yaml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/local/compose.yaml down",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "start:api": "node --env-file=.env services/api/dist/main.js",
    "start:edge": "node --env-file=.env services/edge/dist/main.js",
    "device:setup": "node --env-file=.env scripts/device-setup.mjs",
    "device:revoke": "node --env-file=.env scripts/device-revoke.mjs",
    "menu:publish": "node --env-file=.env scripts/menu-publish.mjs",
    "sync:once": "node --env-file=.env scripts/menu-worker.mjs --once",
    "sync:watch": "node --env-file=.env scripts/menu-worker.mjs",
    "staff:setup": "node --env-file=.env scripts/staff-setup.mjs",
    "staff:revoke": "node --env-file=.env scripts/staff-revoke.mjs",
    "local:request": "node --env-file=.env scripts/local-request.mjs",
    "design:serve": "node scripts/design-server.mjs",
    "design:catalog": "node scripts/design-catalog.mjs",
    "design:check": "node scripts/design-catalog.mjs --check",
    "test:pos": "node --env-file=.env --test --test-concurrency=1 tests/pos/*.test.mjs",
    "test:commerce": "pnpm --filter @pickchick/commerce-core test && pnpm --filter @pickchick/commerce-core test:integration",
    "test:loyalty": "pnpm --filter @pickchick/loyalty-core test && pnpm --filter @pickchick/loyalty-core test:integration",
    "test:backoffice": "node --env-file=.env --test --test-concurrency=1 tests/backoffice/*.test.mjs",
    "test:fulfillment": "pnpm --filter @pickchick/edge-fulfillment test && pnpm --filter @pickchick/edge-fulfillment test:integration",
    "test:kitchen": "pnpm --filter @pickchick/kitchen test && node --env-file=.env --test --test-concurrency=1 tests/kitchen/*.test.mjs",
    "test:fulfillment-transport": "pnpm --filter @pickchick/fulfillment-transport test && pnpm --filter @pickchick/fulfillment-transport test:integration",
    "test:pos-order-sync": "pnpm --filter @pickchick/pos-order-sync test && pnpm --filter @pickchick/pos-order-sync test:integration",
    "pos:sync": "node --env-file=.env scripts/pos-order-sync-worker.mjs",
    "kaspi:worker": "node --env-file=.env services/api/dist/kaspi-remote-worker.js",
    "pos:sync:setup": "node --env-file=.env scripts/pos-order-sync-setup.mjs",
    "project:check": "node scripts/project-sync.mjs check",
    "project:sync": "node scripts/project-sync.mjs sync",
    "project:tasks": "node scripts/project-sync.mjs status",
    "audit:release": "node scripts/dependency-audit.mjs"
  },
  "dependencies": {
    "@pickchick/catalog-admin": "workspace:*",
    "@pickchick/contracts": "workspace:*",
    "@pickchick/database": "workspace:*",
    "@pickchick/platform": "workspace:*",
    "@pickchick/test-fixtures": "workspace:*",
    "@pickchick/test-order-flow": "workspace:*",
    "@pickchick/api": "workspace:*",
    "@pickchick/edge": "workspace:*",
    "@pickchick/menu-sync": "workspace:*",
    "@pickchick/local-orders": "workspace:*",
    "@pickchick/phone-verification": "workspace:*",
    "@pickchick/customer-identity": "workspace:*",
    "@pickchick/fulfillment-transport": "workspace:*",
    "@pickchick/pos-order-sync": "workspace:*",
    "@pickchick/backoffice-core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pickchick/edge-fulfillment": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
