{
  "name": "@pickchick/backoffice-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./finance": {
      "types": "./dist/finance.d.ts",
      "default": "./dist/finance.js"
    },
    "./kiosk-incidents": {
      "types": "./dist/kiosk-incidents.d.ts",
      "default": "./dist/kiosk-incidents.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./devices": {
      "types": "./dist/device-registry.d.ts",
      "default": "./dist/device-registry.js"
    },
    "./workforce": {
      "types": "./dist/workforce-store.d.ts",
      "default": "./dist/workforce-store.js"
    },
    "./cloud-kitchen": {
      "types": "./dist/cloud-kitchen.d.ts",
      "default": "./dist/cloud-kitchen.js"
    },
    "./reconciliation": {
      "types": "./dist/reconciliation.d.ts",
      "default": "./dist/reconciliation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/unit.test.mjs tests/reconciliation-unit.test.mjs tests/consumption-unit.test.mjs tests/discounts-unit.test.mjs",
    "test:integration": "node --env-file=../../.env --test --test-concurrency=1 tests/postgres.test.mjs tests/commerce.test.mjs tests/grants.test.mjs tests/stops.test.mjs tests/kiosk-incidents.test.mjs tests/reconciliation.test.mjs tests/roles.test.mjs tests/stock-v2.test.mjs tests/sales-report.test.mjs tests/p1-schema.test.mjs tests/p1-grants.test.mjs tests/pos-day.test.mjs tests/stock-p1.test.mjs tests/stock-p1-reports.test.mjs tests/consumption.test.mjs tests/manager-shifts.test.mjs tests/staff-positions.test.mjs tests/discounts.test.mjs tests/stock-p1-rollback.test.mjs tests/orders-registry.test.mjs tests/p2-schema.test.mjs tests/p2-grants.test.mjs"
  },
  "dependencies": {
    "@pickchick/database": "workspace:*",
    "@pickchick/catalog-admin": "workspace:*",
    "@pickchick/commerce-core": "workspace:*",
    "@pickchick/cloud-kitchen": "workspace:*",
    "@pickchick/menu-sync": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.3"
  }
}
