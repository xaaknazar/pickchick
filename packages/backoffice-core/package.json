{
  "name": "@pickchick/backoffice-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/unit.test.mjs",
    "test:integration": "node --env-file=../../.env --test --test-concurrency=1 tests/postgres.test.mjs tests/commerce.test.mjs tests/grants.test.mjs"
  },
  "dependencies": {
    "@pickchick/database": "workspace:*",
    "@pickchick/catalog-admin": "workspace:*",
    "@pickchick/commerce-core": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.3"
  }
}
