# Copy into a private mode-600 file under .local, never commit filled credentials.
# Configuration preflight only; this does not enable public phone authentication.
PHONE_DELIVERY_PROVIDER=disabled
MOBIZON_API_KEY=
# Exact sender approved for this account and the intended Kazakhstan operators.
MOBIZON_APPROVED_SENDER=

# Telegram Gateway account token (not a BotFather bot token).
# PHONE_DELIVERY_PROVIDER=telegram_gateway enables Telegram only.
TELEGRAM_GATEWAY_TOKEN=
# Enable only after Mobizon sender/template/budget/delivery are approved.
# A visible user action selects SMS; no automatic fallback sends paid messages.
PHONE_SMS_FALLBACK_ENABLED=false
